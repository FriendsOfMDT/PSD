<Grid x:Name="_rolesTabLayout" Margin="0" Grid.ColumnSpan="2">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="490" />
        <ColumnDefinition Width="150" />
    </Grid.ColumnDefinitions>

    <Label x:Name="_rolesTabMainTitle" Content="@MainTitle" Grid.Column="0" HorizontalAlignment="Left" Margin="10,20,0,0" VerticalAlignment="Top" FontSize="22" />
    <Label x:Name="_rolesTabSubTitle" Content="@SubTitle" Grid.Column="0" HorizontalAlignment="Left" Margin="10,73,0,0" VerticalAlignment="Top" FontSize="14" />
    <TextBlock x:Name="_rolesCatalogStatus" Grid.Column="0" Margin="10,105,14,0" VerticalAlignment="Top" Text="Loading feature catalog..." Foreground="LightGray" />
    <ListBox x:Name="_rolesFeatureList" Grid.Column="0" HorizontalAlignment="Left" Height="375" Margin="10,132,0,0" VerticalAlignment="Top" Width="466" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="#202124" Foreground="White" />
    <TextBox x:Name="TSEnv_OptionalOSRoles" Visibility="Hidden" IsEnabled="False" />
    <TextBox x:Name="TSEnv_OptionalOSRoleServices" Visibility="Hidden" IsEnabled="False" />
    <TextBox x:Name="TSEnv_OptionalOSFeatures" Visibility="Hidden" IsEnabled="False" />

    <Label Content="More Info" Grid.Column="1" FontSize="14" HorizontalAlignment="Left" Margin="10,31,0,0" VerticalAlignment="Top" Foreground="LightSlateGray" />
    <TextBlock x:Name="_rolesTabMoreInfo" Grid.Column="1" HorizontalAlignment="Left" Margin="10,89,0,0" Width="136" TextWrapping="Wrap" VerticalAlignment="Top" Height="422" Foreground="LightGray">
        <Run Text="@Help" />
    </TextBlock>
</Grid>